+/// An output failure together with all bytes committed before it.
+#[derive(Debug, thiserror::Error)]
+#[error("{source}")]
+struct WriteFailure {
+    stats: WriteStat,
+    #[source]
+    source: io::Error,
+}
+
+impl WriteFailure {
+    fn statistics(error: &io::Error) -> WriteStat {
+        error
+            .get_ref()
+            .and_then(|source| source.downcast_ref::<Self>())
+            .map_or_else(WriteStat::default, |failure| failure.stats)
+    }
+}
+
+/// Complete output blocks while retaining progress if a later write fails.
+///
+/// Short writes are normal for pipes and must not depend on input flags.
+/// Unlike `write_all`, this also counts the prefix committed before an error.
+fn write_output_blocks(
+    writer: &mut impl Write,
+    buf: &[u8],
+    block_size: usize,
+) -> io::Result<WriteStat> {
+    let mut stats = WriteStat::default();
+    for chunk in buf.chunks(block_size) {
+        let mut written = 0;
+        while written < chunk.len() {
+            let result = match writer.write(&chunk[written..]) {
+                Ok(0) => Err(io::ErrorKind::WriteZero.into()),
+                result => result,
+            };
+            match result {
+                Ok(count) => {
+                    written += count;
+                    stats.bytes_total += count as u128;
+                }
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+                Err(source) => {
+                    stats.writes_partial += u64::from(written != 0);
+                    return Err(io::Error::new(
+                        source.kind(),
+                        WriteFailure { stats, source },
+                    ));
+                }
+            }
+        }
+        if chunk.len() == block_size {
+            stats.writes_complete += 1;
+        } else {
+            stats.writes_partial += 1;
+        }
+    }
+    Ok(stats)
+}
