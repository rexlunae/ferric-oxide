     use crate::{Output, Parser, calc_bsize};
 
     use std::path::Path;
+    use std::{collections::VecDeque, io};
+
+    use crate::{WriteFailure, write_output_blocks};
+
+    struct ShortWriter {
+        steps: VecDeque<Result<usize, io::ErrorKind>>,
+        bytes: Vec<u8>,
+        calls: usize,
+    }
+
+    impl io::Write for ShortWriter {
+        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+            self.calls += 1;
+            let count = self
+                .steps
+                .pop_front()
+                .unwrap_or(Ok(buf.len()))
+                .map_err(io::Error::from)?
+                .min(buf.len());
+            self.bytes.extend_from_slice(&buf[..count]);
+            Ok(count)
+        }
+
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+
+    fn short_writer(steps: impl IntoIterator<Item = Result<usize, io::ErrorKind>>) -> ShortWriter {
+        ShortWriter {
+            steps: steps.into_iter().collect(),
+            bytes: Vec::new(),
+            calls: 0,
+        }
+    }
+
+    #[test]
+    fn short_output_writes_preserve_every_byte_and_record() {
+        let data: Vec<u8> = (0..17).collect();
+        let mut writer = short_writer([
+            Ok(2),
+            Err(io::ErrorKind::Interrupted),
+            Ok(1),
+            Ok(5),
+            Ok(3),
+            Ok(5),
+            Ok(1),
+        ]);
+        let stats = write_output_blocks(&mut writer, &data, 8).unwrap();
+        assert_eq!(writer.bytes, data);
+        assert_eq!(
+            (
+                stats.writes_complete,
+                stats.writes_partial,
+                stats.bytes_total
+            ),
+            (2, 1, 17)
+        );
+    }
+
+    #[test]
+    fn output_error_keeps_completed_and_partial_progress() {
+        let data: Vec<u8> = (0..20).collect();
+        for error in [io::ErrorKind::BrokenPipe, io::ErrorKind::WriteZero] {
+            let stop = if error == io::ErrorKind::WriteZero {
+                Ok(0)
+            } else {
+                Err(error)
+            };
+            let mut writer = short_writer([Ok(8), Ok(3), stop]);
+            let failure = write_output_blocks(&mut writer, &data, 8).unwrap_err();
+            assert_eq!(failure.kind(), error);
+            let stats = WriteFailure::statistics(&failure);
+            assert_eq!(
+                (
+                    stats.writes_complete,
+                    stats.writes_partial,
+                    stats.bytes_total
+                ),
+                (1, 1, 11)
+            );
+            assert_eq!(writer.bytes, &data[..11]);
+        }
+    }
+
+    #[test]
+    fn empty_output_does_not_issue_a_zero_length_write() {
+        let mut writer = short_writer([Ok(0)]);
+        let stats = write_output_blocks(&mut writer, &[], 8).unwrap();
+        assert_eq!(stats.bytes_total, 0);
+        assert_eq!(writer.calls, 0);
+    }
 
